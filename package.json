{
  "name": "saas-identity-platform-react-native",
  "version": "1.0.0",
  "private": true,
  "description": "xr-code-suite react-native profile 脚手架（Phase 0 骨架，零业务）",
  "templateInfo": null,
  "scripts": {
    "gate": "cd ../.. && python scripts/gate.py -p saas-identity-platform-react-native",
    "start": "react-native start",
    "test": "jest",
    "trace": "TRACE_MAP=1 jest",
    "lint": "eslint .",
    "format": "prettier --write src tests index.js App.tsx",
    "typecheck": "tsc --noEmit",
    "bundle:android": "react-native bundle --platform android --dev false --entry-file index.js --bundle-output _work/bundle/index.android.bundle --assets-dest _work/bundle/assets",
    "gen:shared": "tsx scripts/gen-shared.ts"
  },
  "engines": {
    "node": ">= 22.11.0"
  },
  "dependencies": {
    "react": "19.3.0",
    "react-native": "0.88.1"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@babel/preset-env": "^7.25.3",
    "@babel/runtime": "^7.25.0",
    "@react-native-community/cli": "20.2.0",
    "@react-native-community/cli-platform-android": "20.2.0",
    "@react-native-community/cli-platform-ios": "20.2.0",
    "@react-native/babel-preset": "0.88.1",
    "@react-native/eslint-config": "0.88.1",
    "@react-native/jest-preset": "0.88.1",
    "@react-native/metro-config": "0.88.1",
    "@react-native/typescript-config": "0.88.1",
    "@types/jest": "^29.5.13",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "eslint": "^8.19.0",
    "jest": "^29.6.3",
    "orval": "^7.5.0",
    "prettier": "2.8.8",
    "tsx": "^4.19.0",
    "typescript": "^6.0.3"
  }
}
